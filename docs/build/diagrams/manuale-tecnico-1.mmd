    GW -- "REST /api/v1/contracts/**" --> CS
    GW -- "REST /api/v1/payments/**, /transactions/**" --> PAY
    GW -- "REST /api/v1/feedbacks/**" --> FS
    GW -- "REST /api/v1/notifications/**" --> NS

    PS -. "REST sincrona: stato validazione" .-> US
