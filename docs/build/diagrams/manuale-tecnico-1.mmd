    PAY -. "REST sincrona: stato validazione" .-> US
    FS -. "REST sincrona: stato validazione" .-> US
    NS -. "REST sincrona: stato validazione" .-> US
    PAY -. "REST sincrona: dettagli contratto" .-> CS

    US -- "publish" --> MQ
    PS -- "publish" --> MQ
    PAY -- "publish" --> MQ
    FS -- "publish" --> MQ

    MQ -. "consume" .-> CS
    MQ -. "consume" .-> FS
    MQ -. "consume" .-> US
    MQ -. "consume: tutti gli eventi (#)" .-> NS

    US --> PG
